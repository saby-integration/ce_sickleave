
Функция ПолучитьСотрудникаИзДокумента(СсылкаНаДокумент)

	Сотрудник = Неопределено;

	// Сообщение 120:
	Если СокрЛП(ТипЗнч(СсылкаНаДокумент)) = "Заявления о возмещении расходов, опись документов и заявлений" Тогда
		Сотрудник = СсылкаНаДокумент.ТаблицаПриложения[0].ФИО;
	Иначе
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СсылкаНаДокумент,
			"Сотрудник"
		);
	КонецЕсли;

	Возврат Сотрудник;

КонецФункции


Процедура ВыйтиНаСервере() Экспорт
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	saby_param = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	Если saby_param <> Неопределено Тогда	
		ОбработкаСБИС.ОчиститьСессию(saby_param);
		saby_param.Вставить("password", Неопределено);
		saby_param.Вставить("Сертификат", Неопределено);
		saby_param.Вставить("Certificate", Неопределено);
		ОбработкаСБИС.НастройкиПодключенияЗаписать(saby_param);
	КонецЕсли;
КонецПроцедуры

#Область ОтправкаСообщенияСЭДО

Функция ОтправитьСообщениеСЭДОЧерезAPIСБИС(ПараметрыСообщения) Экспорт

	Результат = Новый Структура("Отправлено, ОписаниеОшибки", Истина, "");	
	
	ПараметрыСообщенияЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ОтпечаткиСертификатов = ПараметрыСообщенияЭДО.ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(
		ПараметрыСообщения.Организация
	);
	ПараметрыСообщения.Вставить(
		"СертификатСтрахователяОтпечаток", 
		ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток
	);	
	ПараметрыСообщения.Вставить("СсылкаМЧДФСС", Неопределено);
	Если ЗначениеЗаполнено(ОтпечаткиСертификатов.МЧД) Тогда
		СсылкаМЧДФСС = Справочники.МашиночитаемыеДоверенностиФСС.НайтиПоРеквизиту(
							"НомерДоверенности", ОтпечаткиСертификатов.МЧД);
		Если НЕ СсылкаМЧДФСС.Пустая() Тогда
			Если НЕ СсылкаМЧДФСС.Представитель_Физлицо Тогда
				Результат.Отправлено = Ложь;
				Результат.ОписаниеОшибки = "Представитель не является физ.лицом. Не поддерживаем отправку с таким типом МЧД!";
				Возврат Результат;
			КонецЕсли;
			Если Метаданные.НайтиПоТипу(ТипЗнч(СсылкаМЧДФСС.ЛицоБезДовФЛ)).Имя = "Контрагенты" Тогда
				Результат.Отправлено = Ложь;
				Результат.ОписаниеОшибки = "Физическое лицо со стороны доверителя является контрагентом."
										 + "Не поддерживаем отправку с таким типом МЧД!";
				Возврат Результат;
			КонецЕсли;
			ПараметрыСообщения.Вставить("СсылкаМЧДФСС", СсылкаМЧДФСС);
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		// Вызовите метод «СБИС.ЗаписатьКомплект» для подготовки документа к отправке.
		// На этом этапе документ появляется в списке больничных в СБИС
		Документ = ЗаписатьКомплект(ПараметрыСообщения);
		
		// Необходимо для отправки запроса в ФСС. На этом этапе передаем подписанный запрос
		// СБИС сразу запрос не отправляет, он делает это асинхронно. Запрос может уйти и через 30 минут
		ПодготовитьВыполнитьДействие(Документ, ПараметрыСообщения);
		
		// Сохраняем связь уида докумнета сбис и ссылки 1С
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
		ОбработкаСБИС.СтатусыДокументовОбновить(Документ["Идентификатор"], ПараметрыСообщения.СсылкаНаДокумент, "0");
		ОтправитьДействиеНаСерверСтатистики("Import", "Отправка проактивных больничных", ОбработкаСБИС);
	Исключение
		Результат.Отправлено = Ложь;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		Результат.ОписаниеОшибки = "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
		ОтправитьОшибкуНаСерверСтатистики("Import", "Отправка проактивных больничных", ОшибкаСтруктура);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

Функция ЗаписатьКомплект(ПараметрыСообщения)
	
	Попытка   
		Документ = ЗаписатьКомплектВызов(ПараметрыСообщения); // Записываем комплект
	Исключение 
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		// Если передали из 1С МЧД, которой ещё нет в СБИС, загрузим её и снова записываем этот же комплект.
		Если ЗначениеЗаполнено(ПараметрыСообщения.СсылкаМЧДФСС)
				И Найти(ВРег(ОшибкаСтруктура.message), "НЕ УДАЛОСЬ НАЙТИ МЧД") > 0 Тогда
			Попытка
				ЗагрузитьМЧДвСБИС(ПараметрыСообщения.СсылкаМЧДФСС); // Загружаем МЧД с СБИС
				Документ = ЗаписатьКомплектВызов(ПараметрыСообщения); // Повторяем вызов записи комплекта
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
				ОписаниеОшибки = "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
				ВызватьИсключение ОписаниеОшибки;
			КонецПопытки;
		Иначе
			ОписаниеОшибки = "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;
	КонецПопытки;
	
	Возврат Документ;
	
КонецФункции

Функция ЗаписатьКомплектВызов(ПараметрыСообщения)
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	Комплект = ПолучитьСтруктуруОтправляемогоКомплекта( 
		ПараметрыСообщения
	);	
	РезультатЗаписиКомплекта = ОбработкаСБИС.local_helper_write_kit(context_params, Комплект); 
	
	Возврат РезультатЗаписиКомплекта[0] 
	
КонецФункции

Функция ПолучитьСтруктуруОтправляемогоКомплекта(ПараметрыСообщения)
	
	Комплект = Новый Структура;	

	Сотрудник = ПолучитьСотрудникаИзДокумента(ПараметрыСообщения.СсылкаНаДокумент);

	// Может есть фукнция API для получения идентификатора из СБИС. Если она есть, то лучше использовать её.
	Комплект.Вставить("Идентификатор", Строка(Новый УникальныйИдентификатор));
	Комплект.Вставить(
		"Расширение", 
		Новый Структура("ИдентификаторКомплекта", Строка(Новый УникальныйИдентификатор))
	);               
	Комплект.Вставить("Тип", "ДокументСЭДО");
	Комплект.Вставить("ПодТип", "");
	Комплект.Вставить("ДатаВремяСоздания", МестноеВремя(ТекущаяУниверсальнаяДата(), "Europe/Moscow"));
	
	НашаОрганизация = МодульЭДОСФССПовтИсп().Saby_НашаОрганизация(ПараметрыСообщения.Организация, Ложь);
	Комплект.Вставить("НашаОрганизация", НашаОрганизация);
				
	Участники = Новый Структура;
	// По организации без филиалов
	Если НЕ ПараметрыСообщения.Организация.ОбособленноеПодразделение Тогда
		Участники.Вставить("Отправитель", НашаОрганизация);
	Иначе
		// У филиала берём ГО, и сертификат должен быть от ГО!
		Участники.Вставить("Отправитель",
			МодульЭДОСФССПовтИсп().Saby_НашаОрганизация(ПараметрыСообщения.Организация.ГоловнаяОрганизация, Ложь));
	КонецЕсли;
	Участники.Вставить("Получатель", Новый Структура("ГосударственнаяИнспекция", "ЕФСС"));
	Участники.Вставить("КонечныйПолучатель", Новый Структура("ГосударственнаяИнспекция", "ЕФСС")); 
	Комплект.Вставить("Участники", Участники);
	
	Комплект.Вставить("Вложение", Новый Массив);
	Вложение = Новый Структура;
	Вложение.Вставить("Идентификатор", Строка(Новый УникальныйИдентификатор));
	Вложение.Вставить("Название", Строка(Сотрудник.Ссылка));
	Вложение.Вставить("Категория", "Основное");	
	Вложение.Вставить(
		"ПодТип", 
		МодульЭДОСФССПовтИсп().ПодтипВложенияПоТипуСообщения(ПараметрыСообщения.ТипСообщения)
	);	
	Вложение.Вставить("Направление", "Исходящий");	
	Вложение.Вставить(
		"ВерсияФормата",
		МодульЭДОСФССПовтИсп().ВерсияФорматаПоТипуСообщения(ПараметрыСообщения.ТипСообщения)
	);
	Вложение.Вставить("Файл", ПолучитьСтруктуруОтправляемогоФайла(ПараметрыСообщения));		
	Комплект.Вложение.Добавить(Вложение);
		
	Комплект.Вставить("Сертификат", Новый Структура);
	Комплект.Сертификат.Вставить("Отпечаток", ПараметрыСообщения.СертификатСтрахователяОтпечаток);
		
	
	Описание = Новый Структура;
	Описание.Вставить("ВидДокумента", "первичный");
	Описание.Вставить(
		"ИмяФормы",
		МодульЭДОСФССПовтИсп().ИмяФормыПоТипуСообщения(ПараметрыСообщения.ТипСообщения)
	);
	Описание.Вставить(
		"КНДФормы", 
		МодульЭДОСФССПовтИсп().ПодтипВложенияПоТипуСообщения(ПараметрыСообщения.ТипСообщения)
	);
	Описание.Вставить("КолФайл", "1"); 

	РеквизитыФизическогоЛица = ПолучитьРеквизитыФизическогоЛица(Сотрудник);

	Описание.Вставить("СНИЛС", get_prop(РеквизитыФизическогоЛица, "СНИЛС", ""));
	Описание.Вставить(
		"ФИО", 
		Новый Структура(
			"Имя, Отчество, Фамилия", 
			get_prop(РеквизитыФизическогоЛица, "Имя",      ""),
			get_prop(РеквизитыФизическогоЛица, "Отчество", ""),
			get_prop(РеквизитыФизическогоЛица, "Фамилия",  "")
		)
	);
	
	Сведения = Новый Структура;
	Сведения.Вставить("Описание", Описание);
	Сведения.Вставить(
		"Пакет", 
		Новый Структура(
			"ВерсПрог, ПрограммаФормированияОтчета", 
			Метаданные.Версия, 
			Метаданные.Имя
		)
	);    	
	// Данные по МЧД, если есть ссылка на элемент справочника
	Если ЗначениеЗаполнено(ПараметрыСообщения.СсылкаМЧДФСС) Тогда
		ДанныеМЧДФСС = ДанныеПоМЧДФСС(ПараметрыСообщения.СсылкаМЧДФСС);
		Доверенности = Новый Массив;
		Доверенности.Добавить(ДанныеМЧДФСС.Доверенность);
		Сведения.Вставить("Доверенность", Доверенности);
		Сведения.Пакет.Вставить("Доверенность", ДанныеМЧДФСС.ПакетДоверенность);
		Комплект.Участники.Отправитель = ДанныеМЧДФСС.Доверенность.ДоверенноеЛицо.Организация;
	КонецЕсли;
	
	Комплект.Вставить("Сведения", Сведения);
	
	Возврат Комплект;
		
КонецФункции

Функция ПолучитьСтруктуруОтправляемогоФайла(ПараметрыСообщения)
	
	СтруктураФайла = Новый Структура;
	СодержимоеСообщения = ?(
		ЭтоАдресВременногоХранилища(ПараметрыСообщения.СодержимоеИлиАдресСообщения),
		ПолучитьИзВременногоХранилища(ПараметрыСообщения.СодержимоеИлиАдресСообщения),
		ПараметрыСообщения.СодержимоеИлиАдресСообщения
	);
	
	ПотокВПамяти = Новый ПотокВПамяти;	
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(ПотокВПамяти, "UTF-8", Ложь);
	// Добавляем объявление XML, если его нет в начале текста
	Если Найти(СодержимоеСообщения, "<?xml version=""1.0""") <> 1 Тогда
		ЗаписьXML.ЗаписатьОбъявлениеXML();
	КонецЕсли;
	ЗаписьXML.ЗаписатьБезОбработки(СодержимоеСообщения);
	ЗаписьXML.Закрыть();	
	
	ИмяФайла = СтрШаблон(
		"%1_%2_%3_%4.xml",
		МодульЭДОСФССПовтИсп().ПодтипВложенияПоТипуСообщения(ПараметрыСообщения.ТипСообщения),
		ПараметрыСообщения.РегистрационныйНомерФСС,
		Формат(ТекущаяДата(), "ДФ=yyyy_MM_dd"),
		Строка(Новый УникальныйИдентификатор)
	); 
	СтруктураФайла.Вставить("Имя", ИмяФайла); 
	
	СтруктураФайла.Вставить("ДвоичныеДанные", Base64Строка(ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные()));
	
	Возврат СтруктураФайла
	
КонецФункции

Функция ВыполнитьINI(algorithm, endpoint, Параметры)
	
	Результат = Неопределено;
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	
	EndpointArgs = Новый Структура;
	Для Каждого Парам Из Параметры Цикл
		set_prop(Параметры, EndpointArgs, Парам.Ключ, Парам.Ключ);
	КонецЦикла;
	ПараметрыКоманды = Новый Структура("Algorithm, Endpoint, EndpointArgs", algorithm, endpoint, EndpointArgs);
	
	РезультатИни = ОбработкаСБИС.LocalCalcIni(ПараметрыКоманды);
	Если РезультатИни["Status"] = "error" Тогда
		ВызватьИсключение NewExtExceptionСтрока(, "Ошибка выполнения ini: '" + ПараметрыКоманды["Algorithm"]
				+ "', endpoint: '" + ПараметрыКоманды["Endpoint"] + "'" + Символы.ПС + РезультатИни.Result.message,
			РезультатИни.Result.detail, РезультатИни.Result.action);
	Иначе
		Результат = РезультатИни["Result"];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


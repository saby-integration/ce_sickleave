
#Область include_core_base_Helpers_ПрефиксПродукта
#КонецОбласти

#Область ОтправкаСообщенияСЭДО

Функция ОтправитьСообщениеСЭДОЧерезAPIСБИС(ПараметрыСообщения) Экспорт

	Результат = Новый Структура("Отправлено, ОписаниеОшибки", Истина, "");	
	
	ПараметрыСообщенияЭДО = ДокументооборотСКО.ПолучитьОбработкуЭДО();
	ОтпечаткиСертификатов = ПараметрыСообщенияЭДО.ПолучитьОтпечаткиСертификатовИзНастроекОрганизацииДляФСС(
		ПараметрыСообщения.Организация
	);
	ПараметрыСообщения.Вставить(
		"СертификатСтрахователяОтпечаток", 
		ОтпечаткиСертификатов.СертификатСтрахователяОтпечаток
	);	
	ПараметрыСообщения.Вставить("СсылкаМЧДФСС", Неопределено);
	Если ЗначениеЗаполнено(ОтпечаткиСертификатов.МЧД) Тогда
		СсылкаМЧДФСС = Справочники.МашиночитаемыеДоверенностиФСС.НайтиПоРеквизиту(
							"НомерДоверенности", ОтпечаткиСертификатов.МЧД);
		Если НЕ СсылкаМЧДФСС.Пустая() Тогда
			Если НЕ СсылкаМЧДФСС.Представитель_Физлицо Тогда
				Результат.Отправлено = Ложь;
				Результат.ОписаниеОшибки = "Представитель не является физ.лицом. Не поддерживаем отправку с таким типом МЧД!";
				Возврат Результат;
			КонецЕсли;
			ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СсылкаМЧДФСС.ЛицоБезДовФЛ));
			Если  ОбъектМетаданных <> Неопределено И ОбъектМетаданных.Имя = "Контрагенты" Тогда
				Результат.Отправлено = Ложь;
				Результат.ОписаниеОшибки = "Физическое лицо со стороны доверителя является контрагентом."
										 + "Не поддерживаем отправку с таким типом МЧД!";
				Возврат Результат;
			КонецЕсли;
			ПараметрыСообщения.Вставить("СсылкаМЧДФСС", СсылкаМЧДФСС);
		КонецЕсли;
	КонецЕсли;
	
	ПодтипВложенияПоТипуСообщения = ВыполнитьINI(
		"Blockly_СформироватьКомплектПроактивногоБольничного_Other",
		"ПодтипВложенияПоТипуСообщения",
		Новый Структура("ТипСообщения", ПараметрыСообщения.ТипСообщения));
	ПараметрыСообщения.Вставить("ПодтипВложенияПоТипуСообщения", ПодтипВложенияПоТипуСообщения);
	
	Попытка
		// Вызовите метод «СБИС.ЗаписатьКомплект» для подготовки документа к отправке.
		// На этом этапе документ появляется в списке больничных в СБИС
		Документ = ЗаписатьКомплект(ПараметрыСообщения);
		
		// Необходимо для отправки запроса в ФСС. На этом этапе передаем подписанный запрос
		// СБИС сразу запрос не отправляет, он делает это асинхронно. Запрос может уйти и через 30 минут
		ПодготовитьВыполнитьДействие(Документ, ПараметрыСообщения);
		
		// Сохраняем связь уида докумнета сбис и ссылки 1С
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
		ОбработкаСБИС.СтатусыДокументовОбновить(Документ["Идентификатор"], ПараметрыСообщения.СсылкаНаДокумент, "0");
		ОтправитьДействиеНаСерверСтатистики("Import", "Отправка проактивных больничных", ОбработкаСБИС);
	Исключение
		Результат.Отправлено = Ложь;
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		Если ОшибкаСтруктура.type = "Unauthorized" Тогда 
			ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке);
		КонецЕсли;
		Результат.ОписаниеОшибки = "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
		ОтправитьОшибкуНаСерверСтатистики("Import", "Отправка проактивных больничных", ОшибкаСтруктура);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

Функция ЗаписатьКомплект(ПараметрыСообщения)
	
	Попытка   
		Документ = ЗаписатьКомплектВызов(ПараметрыСообщения); // Записываем комплект
	Исключение 
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		// Если передали из 1С МЧД, которой ещё нет в СБИС, загрузим её и снова записываем этот же комплект.
		Если ЗначениеЗаполнено(ПараметрыСообщения.СсылкаМЧДФСС)
				И Найти(ВРег(ОшибкаСтруктура.message), "НЕ УДАЛОСЬ НАЙТИ МЧД") > 0 Тогда
			Попытка
				ЗагрузитьМЧДвСБИС(ПараметрыСообщения.СсылкаМЧДФСС); // Загружаем МЧД с СБИС
				Документ = ЗаписатьКомплектВызов(ПараметрыСообщения); // Повторяем вызов записи комплекта
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
				ОписаниеОшибки = "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
				ВызватьИсключение ОписаниеОшибки;
			КонецПопытки;
		Иначе
			ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке);
		КонецЕсли;
	КонецПопытки;
	
	Возврат Документ;
	
КонецФункции

Функция ЗаписатьКомплектВызов(ПараметрыСообщения)
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	Комплект = ПолучитьСтруктуруОтправляемогоКомплекта(ПараметрыСообщения);
	РезультатЗаписиКомплекта = ОбработкаСБИС.local_helper_write_kit(context_params, Комплект);
	
	Возврат РезультатЗаписиКомплекта[0];
	
КонецФункции

Функция ПолучитьСтруктуруОтправляемогоКомплекта(ПараметрыСообщения)
	
	// Добавляем доп.сведения для инишки
	СтруктураОрг = Sedo_ЭДОСФССПовтИсп.Saby_НашаОрганизация(ПараметрыСообщения.Организация, Ложь);
	// По организации без филиалов
	Если НЕ ПараметрыСообщения.Организация.ОбособленноеПодразделение Тогда
		СтруктураГоловнаяОрг = "";
	Иначе
		// У филиала берём ГО, и сертификат должен быть от ГО!
		СтруктураГоловнаяОрг = Sedo_ЭДОСФССПовтИсп.Saby_НашаОрганизация(
									ПараметрыСообщения.Организация.ГоловнаяОрганизация, Ложь);
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Документ",                        ПараметрыСообщения.СсылкаНаДокумент);
	Параметры.Вставить("ТипСообщения",                    ПараметрыСообщения.ТипСообщения);
	Параметры.Вставить("Организация",                     ПараметрыСообщения.Организация);
	Параметры.Вставить("СтруктураОрг",                    СтруктураОрг);
	Параметры.Вставить("СтруктураГоловнаяОрг",            СтруктураГоловнаяОрг);
	Параметры.Вставить("ДатаВремяСоздания",               МестноеВремя(ТекущаяУниверсальнаяДата(), "Europe/Moscow"));
	Параметры.Вставить("ПрограммаФормированияОтчета",     Метаданные.Имя);
	Параметры.Вставить("ВерсияПрограммы",                 Метаданные.Версия);
	Параметры.Вставить("СтруктураОтправляемогоФайла",     ПолучитьСтруктуруОтправляемогоФайла(ПараметрыСообщения));
	Параметры.Вставить("СертификатСтрахователяОтпечаток", ПараметрыСообщения.СертификатСтрахователяОтпечаток);
	Параметры.Вставить("СсылкаМЧДФСС",                    ПараметрыСообщения.СсылкаМЧДФСС);
	
	Комплект = ВыполнитьINI(
		"Blockly_СформироватьКомплектПроактивногоБольничного_Other",
		"main",
		Параметры);
	
	Возврат Комплект;
	
КонецФункции

Функция ПолучитьСтруктуруОтправляемогоФайла(ПараметрыСообщения)
	
	СтруктураФайла = Новый Структура;
	СодержимоеСообщения = ?(
		ЭтоАдресВременногоХранилища(ПараметрыСообщения.СодержимоеИлиАдресСообщения),
		ПолучитьИзВременногоХранилища(ПараметрыСообщения.СодержимоеИлиАдресСообщения),
		ПараметрыСообщения.СодержимоеИлиАдресСообщения
	);
	
	ПотокВПамяти = Новый ПотокВПамяти;	
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(ПотокВПамяти, "UTF-8", Ложь);
	// Добавляем объявление XML, если его нет в начале текста
	Если Найти(СодержимоеСообщения, "<?xml version=""1.0""") <> 1 Тогда
		ЗаписьXML.ЗаписатьОбъявлениеXML();
	КонецЕсли;
	ЗаписьXML.ЗаписатьБезОбработки(СодержимоеСообщения);
	ЗаписьXML.Закрыть();	
	
	ИмяФайла = СтрШаблон(
		"%1_%2_%3_%4.xml",
		ПараметрыСообщения.ПодтипВложенияПоТипуСообщения,
		ПараметрыСообщения.РегистрационныйНомерФСС,
		Формат(ТекущаяДата(), "ДФ=yyyy_MM_dd"),
		Строка(Новый УникальныйИдентификатор)
	); 
	СтруктураФайла.Вставить("Имя", ИмяФайла); 
	
	СтруктураФайла.Вставить("ДвоичныеДанные", Base64Строка(ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные()));
	
	Возврат СтруктураФайла
	
КонецФункции

Функция ВыполнитьINI(algorithm, endpoint, Параметры) Экспорт
	
	Результат = Неопределено;
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	
	EndpointArgs = Новый Структура;
	Для Каждого Парам Из Параметры Цикл
		set_prop(Параметры, EndpointArgs, Парам.Ключ, Парам.Ключ);
	КонецЦикла;
	ПараметрыКоманды = Новый Структура("Algorithm, Endpoint, EndpointArgs", algorithm, endpoint, EndpointArgs);
	
	РезультатИни = ОбработкаСБИС.LocalCalcIni(ПараметрыКоманды);
	Если РезультатИни["Status"] = "error" Тогда
		ВызватьИсключение NewExtExceptionСтрока(, "Ошибка выполнения ini: '" + ПараметрыКоманды["Algorithm"]
				+ "', endpoint: '" + ПараметрыКоманды["Endpoint"] + "'" + Символы.ПС + РезультатИни.Result.message,
			РезультатИни.Result.detail, РезультатИни.Result.action);
	Иначе
		Результат = РезультатИни["Result"];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти


#Область ПолучениеСпискаИзмененийИСпискаСлужебныхЭтапов

Функция СписокИзмененийПоДокументамСЭДО(context_params, Фильтр) Экспорт

	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	Если context_params.Количество() = 0 Тогда                              //при получении сообщений за период
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	Попытка
		СписокИзменений = ОбработкаСБИС.local_helper_read_changes(context_params, Фильтр);
		Если СписокИзменений["Навигация"]["ЕстьЕще"] <> "Да" Тогда
			ОтправитьДействиеНаСерверСтатистики("Export", "Получение проактивных больничных", ОбработкаСБИС, context_params);
		КонецЕсли;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		Если Найти(нрег(ОшибкаСтруктура.message), "не найдено событие с идентификатором")>0 Тогда
			Фильтр.Удалить("ИдентификаторСобытия");
			Попытка
				СписокИзменений = ОбработкаСБИС.local_helper_read_changes(context_params, Фильтр);
				Если СписокИзменений["Навигация"]["ЕстьЕще"] <> "Да" Тогда
					ОтправитьДействиеНаСерверСтатистики("Export", "Получение проактивных больничных", ОбработкаСБИС, context_params);
				КонецЕсли;
			Исключение
				ИнфОбОшибке = ИнформацияОбОшибке();
				ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
				ОтправитьОшибкуНаСерверСтатистики("Export", "Получение проактивных больничных", ОшибкаСтруктура,
					ОбработкаСБИС, context_params);
				ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
			КонецПопытки;
		Иначе
			ОтправитьОшибкуНаСерверСтатистики("Export", "Получение проактивных больничных", ОшибкаСтруктура,
				ОбработкаСБИС, context_params);
			ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
		КонецЕсли;
	КонецПопытки;
	Возврат СписокИзменений;
	
КонецФункции

Функция СписокСлужебныхЭтаповПоДокументамСЭДО(context_params, Фильтр) Экспорт
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	Если context_params.Количество() = 0 Тогда
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	Попытка
		СписокСлужебныхЭтапов = ОбработкаСБИС.local_helper_read_service_changes(context_params, Фильтр);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		Если ОшибкаСтруктура.type = "Unauthorized" Тогда 
			ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке);
		КонецЕсли;
		ОтправитьОшибкуНаСерверСтатистики("Export", "Получение проактивных больничных", ОшибкаСтруктура,
			ОбработкаСБИС, context_params);
		ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
	КонецПопытки;
	
	Возврат СписокСлужебныхЭтапов;
	
КонецФункции

#КонецОбласти


#Область ВспомогательныеФункции

&НаСервере
Процедура ЗагрузитьМЧДвСБИС(СсылкаМЧДФСС)
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	// Параметры для СБИС.ЗаписатьДокумент
	СодержимоеМЧД = Справочники.МашиночитаемыеДоверенностиФСС.ВыгрузитьЭлементВФайлОбмена(
			СсылкаМЧДФСС, Новый УникальныйИдентификатор);
	СтрокаФайлаМЧД = СодержимоеМЧД.Содержимое;
	гуид = СсылкаМЧДФСС.НомерДоверенности;
	
	Файл = Новый Структура();
	Файл.Вставить("ДвоичныеДанные", Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(СтрокаФайлаМЧД)));
	Файл.Вставить("Имя", "ON_EMCHD_" + гуид + ".xml");
	
	Вложение = Новый Структура;
	Вложение.Вставить("Идентификатор", гуид);
	Вложение.Вставить("Файл", Файл);
	
	Вложения = Новый Массив;
	Вложения.Добавить(Вложение);
	
	Документ = Новый Структура;
	Документ.Вставить("Тип", "Доверенность");
	Документ.Вставить("ДопПоля", "Расширение");
	Документ.Вставить("Регламент", Новый Структура("Идентификатор", ""));
	Документ.Вставить("Вложение", Вложения);
	
	Параметры = Новый Структура("Документ", Документ);
	
	Попытка
		// 1. Записываем доверенность с МЧД ФСС в СБИС
		context = context_params;
		kwargs = Новый Структура("multithread_mode, timeout", Ложь, 60);
	    headers = ОбработкаСБИС.local_helper_exec_method_get_headers_for_advanced_log(context);
		Если headers <> Неопределено Тогда
			kwargs.Вставить("headers", headers);
		КонецЕсли;
		response = ОбработкаСБИС.local_helper_exec_method(context, "СБИС.ЗаписатьДокумент", Параметры, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
		
		// 2. Принудительно устанавливаем у неё признак регистрации в СФР
		Параметры = Новый Структура;
		Параметры.Вставить("DocumentID", Результат["Идентификатор"]);
		Параметры.Вставить("MchdType", "ФСС");
		Параметры.Вставить("Marked", "true");
		response = ОбработкаСБИС.local_helper_exec_method(context, "sabyMchd.MarkAsRegistered", Параметры, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДСФРПоОрганизации(Организация) Экспорт
	
	Навигация = Неопределено;
	
	Пока Истина Цикл
		// Получаем порцию МЧД из СБИС.СписокДокументов
		РезультатСписокДокументов = ПолучитьСписокДокументовМЧД(Организация, Навигация);
		Доки = РезультатСписокДокументов["Документ"];
		Навигация = РезультатСписокДокументов["Навигация"];
		Для Каждого Док Из Доки Цикл
			ИмяФайла = Док["Вложение"][0]["Файл"]["Имя"];
			гуидМЧД = ИмяФайла;
			гуидМЧД = СтрЗаменить(гуидМЧД, "powerOfAttorney_", "");
			гуидМЧД = СтрЗаменить(гуидМЧД, ".xml", "");
			СодержимоеФайла = Док["Вложение"][0]["Файл"]["СодержимоеФайла"];
			СпрМЧД = Справочники.МашиночитаемыеДоверенностиФСС.НайтиПоРеквизиту("НомерДоверенности", гуидМЧД);
			// Сохраняем в базе 1с, если таких нет
			Если СпрМЧД.Пустая() Тогда
				РезультатЗагрузки = ДокументооборотСКОВызовСервера.ЗагрузитьМЧДФСС(
					ПоместитьВоВременноеХранилище(СодержимоеФайла),
					Ложь);
				Если НЕ РезультатЗагрузки.Выполнено Тогда
					ЗаписьЖурналаРегистрации(
						ЛокализацияНазваниеПродукта() + ".Ошибка загрузки МЧД." + гуидМЧД + "." + РезультатЗагрузки.Ошибка,
						УровеньЖурналаРегистрации.Ошибка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Навигация["ЕстьЕще"] <> "Да" Тогда
			Прервать;
		Иначе
			Навигация.Вставить("Страница", Число(get_prop(Навигация, "Страница")) + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДСФР() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСС.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
		|ГДЕ
		|	НастройкиОбменаФСС.ИспользоватьОбмен = Истина";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРЗ Из РезультатЗапроса Цикл
		Попытка
			ЗагрузитьМЧДСФРПоОрганизации(СтрокаРЗ.Организация);
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			// Не выводим ошибку, если нет прав на организацию в СБИСе или её там вообще нет
			Если Найти(ИнфоОбОшибке.Описание, "Не найдена действующая, доступная по правам наша организация") > 0 Тогда
				Продолжить;
			Иначе
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСписокДокументовМЧД(Организация, Знач Навигация = Неопределено) Экспорт
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	Фильтр = Новый Структура();
	Фильтр.Вставить("Тип", "ДокументСЭДО");
	Фильтр.Вставить("Подтип", "МЧД");
	Фильтр.Вставить("Состояние", "Утвержденные");
	
	НашаОрганизация = Sedo_ЭДОСФССПовтИсп.Saby_НашаОрганизация(Организация);
	Фильтр.Вставить("НашаОрганизация", НашаОрганизация);
	
	Если Навигация <> Неопределено
			И (ТипЗнч(Навигация) = Тип("Структура") ИЛИ ТипЗнч(Навигация) = Тип("Соответствие")) Тогда
		Фильтр.Вставить("Навигация", Навигация);
	КонецЕсли;
	
	Параметры = Новый Структура();
	Параметры.Вставить("Фильтр", Фильтр);
	Попытка
		// Получаем данные по МЧД
		context = context_params;
		document = Параметры;
		kwargs = Новый Структура("multithread_mode, timeout", Ложь, 60);
	    headers = ОбработкаСБИС.local_helper_exec_method_get_headers_for_advanced_log(context);
		Если  headers <> Неопределено Тогда
			kwargs.Вставить("headers", headers);
		КонецЕсли;
		response = ОбработкаСБИС.local_helper_exec_method(context, "СБИС.СписокДокументов", document, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
		// Скачиваем содержимое файлов МЧД
		Для Каждого Док Из Результат["Документ"] Цикл
			Ссылка = Док["Вложение"][0]["Файл"]["Ссылка"];
			СодержимоеФайла = ОбработкаСБИС.local_helper_download_from_link(context_params, Ссылка, "text");
			Док["Вложение"][0]["Файл"]["СодержимоеФайла"] = СодержимоеФайла;
		КонецЦикла;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьДействиеНаСерверСтатистики(Действие, КонтекстДействия,
		ОбработкаСБИС = Неопределено, context_params = Неопределено)
		
	Если ОбработкаСБИС = Неопределено Тогда
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	КонецЕсли;
	
	Если context_params = Неопределено Тогда
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	
	ЭлементСтатистики = ОбработкаСБИС.local_helper_element_action(Действие, КонтекстДействия, Новый Структура(), 1);
	
	МассивУспехов = Новый Массив;
 	МассивУспехов.Добавить(ЭлементСтатистики);
	
	ОбработкаСБИС.local_helper_register_actions(context_params, МассивУспехов);
	
КонецПроцедуры

Процедура ОтправитьОшибкуНаСерверСтатистики(Действие, КонтекстДействия, ОшибкаСтруктура,
		ОбработкаСБИС = Неопределено, context_params = Неопределено)
		
	Если ОбработкаСБИС = Неопределено Тогда
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	КонецЕсли;
	
	Если context_params = Неопределено Тогда
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	
	ЭлементСтатистики = ОбработкаСБИС.local_helper_element_err(Действие, КонтекстДействия,
		ОшибкаСтруктура.message, ОшибкаСтруктура.detail, Новый Структура(), 500, 1);
	
	МассивОшибок = Новый Массив;
	МассивОшибок.Добавить(ЭлементСтатистики);
	
	ОбработкаСБИС.local_helper_register_errors(context_params, МассивОшибок);
	
КонецПроцедуры


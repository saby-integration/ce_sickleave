&НаСервере
Процедура ЗагрузитьМЧДвСБИС(СсылкаМЧДФСС)
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	// Параметры для СБИС.ЗаписатьДокумент
	СтрокаФайлаМЧД = СсылкаМЧДФСС.ФайлВырузки.Получить();
	гуид = СсылкаМЧДФСС.НомерДоверенности;
	
	Файл = Новый Структура();
	Файл.Вставить("ДвоичныеДанные", Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(СтрокаФайлаМЧД)));
	Файл.Вставить("Имя", "ON_EMCHD_" + гуид + ".xml");
	
	Вложение = Новый Структура;
	Вложение.Вставить("Идентификатор", гуид);
	Вложение.Вставить("Файл", Файл);
	
	Вложения = Новый Массив;
	Вложения.Добавить(Вложение);
	
	Документ = Новый Структура;
	Документ.Вставить("Тип", "Доверенность");
	Документ.Вставить("ДопПоля", "Расширение");
	Документ.Вставить("Регламент", Новый Структура("Идентификатор", ""));
	Документ.Вставить("Вложение", Вложения);
	
	Параметры = Новый Структура("Документ", Документ);
	
	Попытка
		// 1. Записываем доверенность с МЧД ФСС в СБИС
		context = context_params;
		kwargs = Новый Структура("multithread_mode, timeout", Ложь, 60);
	    headers = ОбработкаСБИС.local_helper_exec_method_get_headers_for_advanced_log(context);
		Если headers <> Неопределено Тогда
			kwargs.Вставить("headers", headers);
		КонецЕсли;
		response = ОбработкаСБИС.local_helper_exec_method(context, "СБИС.ЗаписатьДокумент", Параметры, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
		
		// 2. Принудительно устанавливаем у неё признак регистрации в СФР
		Параметры = Новый Структура;
		Параметры.Вставить("DocumentID", Результат["Идентификатор"]);
		Параметры.Вставить("MchdType", "ФСС");
		Параметры.Вставить("Marked", "true");
		response = ОбработкаСБИС.local_helper_exec_method(context, "sabyMchd.MarkAsRegistered", Параметры, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДСФРПоОрганизации(Организация) Экспорт
	
	Навигация = Неопределено;
	
	Пока Истина Цикл
		// Получаем порцию МЧД из СБИС.СписокДокументов
		РезультатСписокДокументов = ПолучитьСписокДокументовМЧД(Организация, Навигация);
		Доки = РезультатСписокДокументов["Документ"];
		Навигация = РезультатСписокДокументов["Навигация"];
		Для Каждого Док Из Доки Цикл
			ИмяФайла = Док["Вложение"][0]["Файл"]["Имя"];
			гуидМЧД = ИмяФайла;
			гуидМЧД = СтрЗаменить(гуидМЧД, "powerOfAttorney_", "");
			гуидМЧД = СтрЗаменить(гуидМЧД, ".xml", "");
			СодержимоеФайла = Док["Вложение"][0]["Файл"]["СодержимоеФайла"];
			СпрМЧД = Справочники.МашиночитаемыеДоверенностиФСС.НайтиПоРеквизиту("НомерДоверенности", гуидМЧД);
			// Сохраняем в базе 1с, если таких нет
			Если СпрМЧД.Пустая() Тогда
				РезультатЗагрузки = ДокументооборотСКОВызовСервера.ЗагрузитьМЧДФСС(
					ПоместитьВоВременноеХранилище(СодержимоеФайла),
					Ложь);
				Если НЕ РезультатЗагрузки.Выполнено Тогда
					ЗаписьЖурналаРегистрации(
						ЛокализацияНазваниеПродукта() + ". Ошибка загрузки МЧД " + гуидМЧД + "." + РезультатЗагрузки.Ошибка,
						УровеньЖурналаРегистрации.Ошибка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Навигация["ЕстьЕще"] <> "Да" Тогда
			Прервать;
		Иначе
			Навигация.Вставить("Страница", Число(get_prop(Навигация, "Страница")) + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьМЧДСФР() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиОбменаФСС.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.НастройкиОбменаФСС КАК НастройкиОбменаФСС
		|ГДЕ
		|	НастройкиОбменаФСС.ИспользоватьОбмен = Истина";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРЗ Из РезультатЗапроса Цикл
		Попытка
			ЗагрузитьМЧДСФРПоОрганизации(СтрокаРЗ.Организация);
		Исключение
			ИнфоОбОшибке = ИнформацияОбОшибке();
			// Не выводим ошибку, если нет прав на организацию в СБИСе или её там вообще нет
			Если Найти(ИнфоОбОшибке.Описание, "Не найдена действующая, доступная по правам наша организация") > 0 Тогда
				Продолжить;
			Иначе
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСписокДокументовМЧД(Организация, Знач Навигация = Неопределено) Экспорт
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	
	Фильтр = Новый Структура();
	Фильтр.Вставить("Тип", "ДокументСЭДО");
	Фильтр.Вставить("Подтип", "МЧД");
	Фильтр.Вставить("Состояние", "Утвержденные");
	
	НашаОрганизация = МодульЭДОСФССПовтИсп().Saby_НашаОрганизация(Организация);
	Фильтр.Вставить("НашаОрганизация", НашаОрганизация);
	
	Если Навигация <> Неопределено
			И (ТипЗнч(Навигация) = Тип("Структура") ИЛИ ТипЗнч(Навигация) = Тип("Соответствие")) Тогда
		Фильтр.Вставить("Навигация", Навигация);
	КонецЕсли;
	
	Параметры = Новый Структура();
	Параметры.Вставить("Фильтр", Фильтр);
	Попытка
		// Получаем данные по МЧД
		context = context_params;
		document = Параметры;
		kwargs = Новый Структура("multithread_mode, timeout", Ложь, 60);
	    headers = ОбработкаСБИС.local_helper_exec_method_get_headers_for_advanced_log(context);
		Если  headers <> Неопределено Тогда
			kwargs.Вставить("headers", headers);
		КонецЕсли;
		response = ОбработкаСБИС.local_helper_exec_method(context, "СБИС.СписокДокументов", document, Истина, kwargs);
		Результат = ОбработкаСБИС.local_helper_api_process_responce(response);
		// Скачиваем содержимое файлов МЧД
		Для Каждого Док Из Результат["Документ"] Цикл
			Ссылка = Док["Вложение"][0]["Файл"]["Ссылка"];
			СодержимоеФайла = ОбработкаСБИС.local_helper_download_from_link(context_params, Ссылка, "text");
			Док["Вложение"][0]["Файл"]["СодержимоеФайла"] = СодержимоеФайла;
		КонецЦикла;
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
		ВызватьИсключение "" + ОшибкаСтруктура.action + " " + ОшибкаСтруктура.message + " " + ОшибкаСтруктура.detail;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ОтправитьДействиеНаСерверСтатистики(Действие, КонтекстДействия,
		ОбработкаСБИС = Неопределено, context_params = Неопределено)
		
	Если ОбработкаСБИС = Неопределено Тогда
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	КонецЕсли;
	
	Если context_params = Неопределено Тогда
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	
	ЭлементСтатистики = ОбработкаСБИС.local_helper_element_action(Действие, КонтекстДействия, Новый Структура(), 1);
	
	МассивУспехов = Новый Массив;
 	МассивУспехов.Добавить(ЭлементСтатистики);
	
	ОбработкаСБИС.local_helper_register_actions(context_params, МассивУспехов);
	
КонецПроцедуры

Процедура ОтправитьОшибкуНаСерверСтатистики(Действие, КонтекстДействия, ОшибкаСтруктура,
		ОбработкаСБИС = Неопределено, context_params = Неопределено)
		
	Если ОбработкаСБИС = Неопределено Тогда
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	КонецЕсли;
	
	Если context_params = Неопределено Тогда
		context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать();
	КонецЕсли;
	
	ЭлементСтатистики = ОбработкаСБИС.local_helper_element_err(Действие, КонтекстДействия,
		ОшибкаСтруктура.message, ОшибкаСтруктура.detail, Новый Структура(), 500, 1);
	
	МассивОшибок = Новый Массив;
	МассивОшибок.Добавить(ЭлементСтатистики);
	
	ОбработкаСБИС.local_helper_register_errors(context_params, МассивОшибок);
	
КонецПроцедуры


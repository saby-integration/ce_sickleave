Функция ЗагрузитьСообщениеФССXMLИзСбис(СсылкаНаФайл, КодировкаUTF8 = Истина) Экспорт
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	context_params = ОбработкаСБИС.НастройкиПодключенияПрочитать(); 
	
	ФайлДокументаСЭДО = ОбработкаСБИС.local_helper_download_from_link(context_params, СсылкаНаФайл); 
	
	Если КодировкаUTF8 Тогда
		Чтение = Новый ЧтениеТекста(ФайлДокументаСЭДО.ОткрытьПотокДляЧтения(), КодировкаТекста.UTF8);
	Иначе
		Чтение = Новый ЧтениеТекста(ФайлДокументаСЭДО.ОткрытьПотокДляЧтения());
	КонецЕсли;
	СообщениеФССXML = Чтение.Прочитать();
	Чтение.Закрыть();
	
	Возврат СообщениеФССXML;
	
КонецФункции

Функция ЗаписатьУведомлениеОбОшибке(ИдентификаторЗапроса, Документ) Экспорт
	
	Попытка
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
		Выборка = ОбработкаСБИС.СтатусыДокументовПрочитатьПоUID(Документ["Идентификатор"]);
		Если Не Выборка.Следующий() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Объект1С = Выборка.Объект;
		
		Объект1СОрганизация = get_prop(Объект1С, "Организация");
		Если Объект1СОрганизация = Неопределено Тогда
			Объект1СОрганизация = get_prop(Объект1С, "Страхователь");
		КонецЕсли;
		
		СообщениеОбОшибке = ЗагрузитьСообщениеФССXMLИзСбис(Документ["Событие"][0]["Вложение"][0]["Файл"]["Ссылка"], Ложь);
		
		РезультатОтправки = Новый Структура;
		РезультатОтправки.Вставить("ПолноеИмяДокумента",     Объект1С.Метаданные().ПолноеИмя());
		РезультатОтправки.Вставить("Ссылка",                 Объект1С.Ссылка);
		РезультатОтправки.Вставить("Страхователь",           Объект1СОрганизация);
		РезультатОтправки.Вставить("ГоловнаяОрганизация",    Объект1СОрганизация);
		РезультатОтправки.Вставить("ТекстОшибки",            СообщениеОбОшибке);
		РезультатОтправки.Вставить("ИдентификаторСообщения", ИдентификаторЗапроса);
		РезультатОтправки.Вставить("ИдентификаторПакета",    "");
		РезультатОтправки.Вставить("Успех",                  Ложь);
		РезультатОтправки.Вставить("ОтправленоОператору",    Ложь);
		РезультатОтправки.Вставить("ДоставленоФонду",        Ложь);
		РезультатОтправки.Вставить("ДатаОтправки",           ТекущаяДатаСеанса());
		РезультатОтправки.Вставить("ДатаОтправкиОператору",  '00010101');
		РезультатОтправки.Вставить("ДатаОтправкиФонду",      ТекущаяДатаСеанса());
		РезультатОтправки.Вставить("Измененные",             Новый Массив);
		
		СЭДОФСС.ЗарегистрироватьНепосредственныйРезультатОтправкиДокумента(РезультатОтправки);
		
		Возврат Новый Структура("ДокСсылка, СообщениеОбОшибке", Объект1С.Ссылка, СообщениеОбОшибке);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ЗаписатьSEDI_UUID(ИдентификаторЗапроса, Документ) Экспорт
	
	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	Выборка = ОбработкаСБИС.СтатусыДокументовПрочитатьПоUID(Документ["Идентификатор"]);
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект1С = Выборка.Объект;
	
	Если СокрЛП(ТипЗнч(Объект1С)) = "Ответ страхователя на обращение СФР" Тогда
		ДокументОбъект = Объект1С.ПолучитьОбъект();
		ДокументОбъект.ДатаОтправки        = ТекущаяДатаСеанса();
		ДокументОбъект.ИдентификаторОтвета = ИдентификаторЗапроса;
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, Ложь, РежимЗаписиДокумента.Запись);
		Возврат Истина;
	КонецЕсли;
	
	Если Найти(НРег(ТипЗнч(Объект1С)), НРег("Входящий документ СЭДО СФР")) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Фомируем строку списка, что бы 1С корректно обработала ответ и записала UUID в документ и нужные регистры.
	СтрокаСписка = Новый Структура;
	СтрокаСписка.Вставить("Ссылка", Объект1С);
	СтрокаСписка.Вставить("ДоставкаИдентификатор", ИдентификаторЗапроса);
	СтрокаСписка.Вставить("Доставлен", Истина);
	СтрокаСписка.Вставить("ДатаОтправки", ТекущаяДата());
	СтрокаСписка.Вставить("Результат", "");
	СтрокаСписка.Вставить("ЗначениеРасшифровки", "");
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(
		Объект1С.Метаданные().ПолноеИмя()
	);
	Попытка
		Менеджер.ЗарегистрироватьРезультатыОтправки(СтрокаСписка, Новый Массив);
	Исключение
		// Новый вариант записи 
		Объект1СОрганизация = get_prop(Объект1С, "Организация");
		Если Объект1СОрганизация = Неопределено Тогда
			Объект1СОрганизация = get_prop(Объект1С, "Страхователь");
		КонецЕсли;
		СтрокаСписка.Вставить("Измененные", Новый Массив);
		СтрокаСписка.Вставить("Страхователь", Объект1СОрганизация);
		СтрокаСписка.Вставить("ГоловнаяОрганизация", Объект1СОрганизация.ГоловнаяОрганизация);
		СтрокаСписка.Вставить("ИдентификаторСообщения", ИдентификаторЗапроса);
		СтрокаСписка.Вставить("ДоставленоФонду", Истина);
		СтрокаСписка.Вставить("Успех", Истина);
		СтрокаСписка.Вставить("ДатаОтправкиФонду", ТекущаяДата());
		СтрокаСписка.Вставить("ТекстОшибки", "");
		СтрокаСписка.Вставить("ОтправленоОператору", Ложь);
		СтрокаСписка.Вставить("ДатаОтправкиОператору", Дата(1,1,1));
		СтрокаСписка.Вставить("ИдентификаторПакета", "");
		Менеджер.ЗарегистрироватьРезультатОтправки(СтрокаСписка);
	КонецПопытки;
	
КонецФункции


Функция ПолучитьСтруктуруПодготовливаемогоДействия(Знач Документ, ПараметрыСообщения)
	
	ПодготавливаемоеДействие = Новый Структура;
	
	ПодготавливаемоеДействие.Вставить("Идентификатор", Документ["Идентификатор"]); 
	ПодготавливаемоеДействие.Вставить("Тип", Документ["Тип"]);
	ПодготавливаемоеДействие.Вставить("ПодТип", ""); 
	ПодготавливаемоеДействие.Вставить("Этап", Новый Структура);
	
	ПодготавливаемоеДействие.Этап.Вставить("Название", Документ["Этап"][0]["Название"]); 
	ПодготавливаемоеДействие.Этап.Вставить("Идентификатор", Документ["Этап"][0]["Идентификатор"]); 
	
	ПодготавливаемоеДействие.Этап.Вставить("Действие", Новый Структура); 
	ПодготавливаемоеДействие.Этап.Действие.Вставить("Название", Документ["Этап"][0]["Действие"][0]["Название"]); 
	ПодготавливаемоеДействие.Этап.Действие.Вставить("Комментарий", ""); 
		
	Если ПараметрыСообщения <> Неопределено Тогда
		Сертификат = Новый Структура; 
		Сертификат.Вставить("Отпечаток", ПараметрыСообщения.СертификатСтрахователяОтпечаток); 
		Сертификат.Вставить("Ключ", Новый Структура("Тип", "Клиентский")); 
		ПодготавливаемоеДействие.Этап.Действие.Вставить("Сертификат", Сертификат);
	КонецЕсли;
		
	Возврат ПодготавливаемоеДействие;
		
КонецФункции

Функция ПолучитьСтруктуруВыполняемогоДействия(Знач РезультатПодготовкиДействия, ПараметрыСообщения)
			
	Если ПараметрыСообщения.Свойство("АдресПодписаногоЗапросаSOAP") Тогда
		РезультатПодготовкиДействия["Этап"][0]["Вложение"][0].Вставить("Подпись", Новый Массив);
		
		// BSLLS:MissingTempStorageDeletion-off
		СодержимоеСообщения = ПолучитьИзВременногоХранилища(ПараметрыСообщения.АдресПодписаногоЗапросаSOAP);
		// BSLLS:MissingTempStorageDeletion-on	
		СодержимоеСообщения = ПолучитьСтрокуИзДвоичныхДанных(СодержимоеСообщения);
		ПотокВПамяти = Новый ПотокВПамяти;	
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьПоток(ПотокВПамяти, "UTF-8", Ложь);
		// Добавляем объявление XML, если его нет в начале текста
		Если Найти(СодержимоеСообщения, "<?xml version=""1.0""") <> 1 Тогда
			ЗаписьXML.ЗаписатьОбъявлениеXML();
		КонецЕсли;
		ЗаписьXML.ЗаписатьБезОбработки(СодержимоеСообщения);
		ЗаписьXML.Закрыть();	
		СодержимоеСообщения = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		
		Файл = Новый Структура;
		Файл.Вставить("Имя", РезультатПодготовкиДействия["Этап"][0]["Вложение"][0]["Файл"]["Имя"] + ".p7s");
		Файл.Вставить("ДвоичныеДанные", Base64Строка(СодержимоеСообщения));
		
		Подпись = Новый Структура;  
		Подпись.Вставить("Тип", "XMLFSS");
		Подпись.Вставить("Файл", Файл);
			
		РезультатПодготовкиДействия["Этап"][0]["Вложение"][0]["Подпись"].Добавить(Подпись); 
	КонецЕсли;
	
	Если ПараметрыСообщения.Свойство("АдресРасшифрованногоОтветаSOAP") Тогда
    	Файл = Новый Структура; 
		Файл.Вставить("Имя", РезультатПодготовкиДействия["Этап"][0]["Вложение"][0]["Файл"]["Имя"]);
		
		Поток = Новый ПотокВПамяти;
		Запись = Новый ЗаписьТекста;
		Запись.Открыть(Поток, КодировкаТекста.UTF8);
		Запись.Записать(ПолучитьИзВременногоХранилища(ПараметрыСообщения.АдресРасшифрованногоОтветаSOAP));
		Запись.Закрыть();
		
		Файл.Вставить(
			"ДвоичныеДанные", 
			Base64Строка(
				Поток.ЗакрытьИПолучитьДвоичныеДанные()	
			)
		);
		
		РезультатПодготовкиДействия["Этап"][0]["Вложение"][0]["Файл"] = Файл;
	КонецЕсли;
		
	ВыполняемоеДействие = Новый Структура;
	set_prop(РезультатПодготовкиДействия, ВыполняемоеДействие, "Идентификатор", "Идентификатор");
	set_prop(РезультатПодготовкиДействия, ВыполняемоеДействие, "Редакция", "Редакция");
	
	ВыполняемоеДействие.Вставить("Этап", Новый Структура);
	ВыполняемоеДействие.Этап.Вставить("Название", РезультатПодготовкиДействия["Этап"][0]["Название"]); 
	ВыполняемоеДействие.Этап.Вставить("Идентификатор", РезультатПодготовкиДействия["Этап"][0]["Идентификатор"]); 
	ВыполняемоеДействие.Этап.Вставить("Действие", Новый Структура); 
	ВыполняемоеДействие.Этап.Действие.Вставить("Название", РезультатПодготовкиДействия["Этап"][0]["Действие"][0]["Название"]); 
	
	Сертификат = Новый Структура; 
	Сертификат.Вставить("Отпечаток", РезультатПодготовкиДействия["Этап"][0]["Действие"][0]["Сертификат"][0]["Отпечаток"]); 
	Сертификат.Вставить("Ключ", РезультатПодготовкиДействия["Этап"][0]["Действие"][0]["Сертификат"][0]["Ключ"]); 
	ВыполняемоеДействие.Этап.Действие.Вставить("Сертификат", Сертификат);
	
	set_prop(РезультатПодготовкиДействия["Этап"][0], ВыполняемоеДействие["Этап"], "Вложение", "Вложение");
	
	Возврат ВыполняемоеДействие;
		
КонецФункции

Процедура СохранитьДатуОтправкиПодтвержденияОПрочтении(Организация, ИдентификаторыСообщений) Экспорт

	Для каждого ИдентификаторСообщения Из ИдентификаторыСообщений Цикл
		Запись = РегистрыСведений.ВходящиеСообщенияСЭДОФСС.СоздатьМенеджерЗаписи();
		Запись.Организация = Организация;
		Запись.Идентификатор = ИдентификаторСообщения.Идентификатор;
		Запись.Прочитать();
		Если НЕ Запись.ПодтверждениеОтправлено Тогда
			Запись.Организация = Организация;
			Запись.Идентификатор = ИдентификаторСообщения.Идентификатор;
			Запись.ДатаОтправкиПодтверждения = ИдентификаторСообщения.Дата;
			Запись.ПодтверждениеОтправлено = Истина;
			Запись.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура РазобратьВходящееСообщениеИСвязатьДокументСЭДО(Организация, ПодТип, Идентификатор,
				АдресРасшифрованногоОтветаSOAP) Экспорт
		
	// Сообщения 600, 601, 602:
	Если Найти(ПодТип, "SEDI_DISCOUNT_DECISION") > 0 Тогда
		// Разбираем сообщение
		СообщениеФССXML = ПолучитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
		УдалитьИзВременногоХранилища(АдресРасшифрованногоОтветаSOAP);
		// по аналогии функции разбора из СЭДО:
		// Обработка.ДокументооборотСКонтролирующимиОрганами.КонтейнерКлиентскийхМетодов.
		//Функция РазобратьОтветПолучитьСообщениеСЭДОФСС(СодержимоеОтвета, ДатаСообщения = ...)
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(СообщениеФССXML);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
		
		УзелДанных = ДанныеОтвета.Body.sedoMessageResponse;
		Если УзелДанных.Свойства().Получить("result") = Неопределено Тогда
			УзелДанныеСообщения = УзелДанных.packageResult.sedoMessageList.sedoMessage;
		Иначе
			УзелДанныеСообщения = УзелДанных.result;
		КонецЕсли;
		
		// Нужно достать тип сообщения
		ТипСообщения = Строка(ДанныеОтвета.Body.sedoMessageResponse.result.messageType);
		
		// Раскодируем вложенное сообщение
		СообщениеBase64 = УзелДанныеСообщения.message;
		Данные = Base64Значение(СообщениеBase64);
		
		Чтение = Новый ЧтениеДанных(Данные);
		ТекстСообщения = Чтение.ПрочитатьСимволы();
		Чтение.Закрыть();
		
		// В некоторых случаях текст сообщения приходит без кодирования в Base64.
		Если ПустаяСтрока(ТекстСообщения) Тогда
			ТекстСообщения = СообщениеBase64;
		КонецЕсли;

		// Читаем внутренние данные сообщения
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(ТекстСообщения);
		ДанныеОтвета = ФабрикаXDTO.ПрочитатьXML(Чтение);
		Чтение.Закрыть();
		
		// Нужно достать УИД из сообщения
		ИдентификаторВДокументе1С = Идентификатор;
		Если ДанныеОтвета.Свойства().Получить("idMessage") <> Неопределено Тогда
			ИдентификаторВДокументе1С = ДанныеОтвета.idMessage;
		КонецЕсли;
		// УИД из тела сообщения прописан в документе 1С
		СсылкаНаДокумент = НайтиВходящийДокументСЭДОФСС(Организация, ИдентификаторВДокументе1С, ТипСообщения);
		Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
			Возврат;
		КонецЕсли;
		
		// Сохраняем связь УИДа документа СБИС и ссылки на документ 1С
		ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
		ОбработкаСБИС.СтатусыДокументовОбновить(Идентификатор, СсылкаНаДокумент, "0");
		
		// Записываем дату отправки подтверждения сразу при получении 60Х, чтобы убрать
		// пугающую информацию о просрочке отправки подтверждения приема с формы документа
		ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
		ДокументОбъект.ДатаОтправкиПодтверждения = ТекущаяДатаСеанса();
		КолДней = 6; КолСекундВДне = 86400;
		ДокументОбъект.МаксимальнаяДатаПодтверждения = ДокументОбъект.ДатаОтправкиПодтверждения + КолДней * КолСекундВДне;
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, Ложь, РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиВходящийДокументСЭДОФСС(Организация, Идентификатор, ТипСообщения) Экспорт
	
	// Поиск документа.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВходящийДокументСЭДОФСС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВходящийДокументСЭДОФСС КАК ВходящийДокументСЭДОФСС
	|ГДЕ
	|	ВходящийДокументСЭДОФСС.ИдентификаторСообщения = &ИдентификаторСообщения
	|	И ВходящийДокументСЭДОФСС.ТипСообщения = &ТипСообщения
	|	И ВходящийДокументСЭДОФСС.Организация = &Организация
	|	И ВходящийДокументСЭДОФСС.ПометкаУдаления = ЛОЖЬ
	|";
	Запрос.УстановитьПараметр("ИдентификаторСообщения", Идентификатор);
	Запрос.УстановитьПараметр("ТипСообщения", Строка(ТипСообщения));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Выборка.Ссылка;
	
КонецФункции

Процедура СохранитьДатуОтправкиПодтвержденияОПрочтенииВоВходящемДокументеСЭДО(Идентификатор,
				ДатаОтправкиПодстверждения) Экспорт

	ОбработкаСБИС = Обработки[ИмяОбработки()].Создать();
	Выборка = ОбработкаСБИС.СтатусыДокументовПрочитатьПоUID(Идентификатор);
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Объект1С = Выборка.Объект;
	
	Если Найти(НРег(ТипЗнч(Объект1С)), НРег("Входящий документ СЭДО СФР")) > 0 Тогда
		ДокументОбъект = Объект1С.ПолучитьОбъект();
		ДокументОбъект.Статус = "Получено";
		ДокументОбъект.ПодтверждениеПолученоФСС = Истина;
		ДокументОбъект.ДатаОтправкиПодтверждения = ДатаОтправкиПодстверждения;
		СЭДОФСС.ЗаписатьДокумент(ДокументОбъект, Истина, Ложь, РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
КонецПроцедуры


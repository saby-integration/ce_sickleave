
Функция ПолучитьСотрудникаИзДокумента(СсылкаНаДокумент)

	Сотрудник = Неопределено;

	// Сообщение 120:
	Если СокрЛП(ТипЗнч(СсылкаНаДокумент)) = "Заявление в СФР о возмещении выплат родителям детей-инвалидов" Тогда
		Сотрудник = СсылкаНаДокумент.Оплаты[0].Сотрудник;
	Иначе
		Сотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			СсылкаНаДокумент,
			"Сотрудник"
		);
	КонецЕсли;

	Возврат Сотрудник;

КонецФункции


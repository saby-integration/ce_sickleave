Функция ПриИспользованииСЭДОЗагрузитьМЧД()
	
	Если МодульЭДОСФСС().ПолучитьЗначениеФункциональнойОпции(ПрефиксПродукта() + "ИспользоватьЭЛН") Тогда

		Попытка
			Орг = ЭтотОбъект.ОрганизацияОтбора;
		Исключение
			Орг = Неопределено;
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(Орг) Тогда
			Попытка
				Орг = ЭтотОбъект.ВладелецФормы.Запись.Организация;
			Исключение
				Орг = Неопределено;
			КонецПопытки
		КонецЕсли;

		Если ЗначениеЗаполнено(Орг) Тогда
			МодульЭДОСФСС().ЗагрузитьМЧДСФРПоОрганизации(Орг);
		Иначе
			// Загрузка по всем организациям в настройках
			МодульЭДОСФСС().ЗагрузитьМЧДСФР();
		КонецЕсли;

		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;       
	
КонецФункции

&НаКлиенте
&Вместо("Загрузить")
Процедура Saby_Загрузить(Команда)

	Если ПриИспользованииСЭДОЗагрузитьМЧД() Тогда

		Элементы.Список.Обновить(); // Обновить данные списка МЧД на форме

	Иначе

		ПродолжитьВызов(Команда);

	КонецЕсли;

КонецПроцедуры

